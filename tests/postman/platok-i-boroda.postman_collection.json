              ],
              "path": [
                "api",
                "stats"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Есть поле runs', () => pm.expect(pm.response.json()).to.have.property('runs'));"
